  "issues": [
    {
      "id": "I1",
      "question": "Whether the evidence, viewed for the nonmovant, permits a reasonable jury to find uncompensated overtime work and actual or constructive employer knowledge under the FLSA.",
      "standard_of_review": "De novo; Rule 56 nonmovant reasonable inferences, substantive FLSA knowledge and worktime requirements.",
      "preservation_status": "Raised in opposition and June 29 hearing; resolved in final summary judgment.",
      "appellant_theory": "Specific after-punch user events and supervisor communications support inference of work and knowledge; correction process does not automatically defeat liability.",
      "appellee_theory": "Event timestamps do not measure continuous work, general reminder and prompt direction to correct time do not establish employer knowledge of actual uncompensated work; no reliable weekly duration evidence.",
      "appellant_relief": "Vacate summary judgment and remand for further proceedings.",
      "appellee_relief": "Affirm final judgment.",
      "ruling_document_id": "CA9-SUP-000002-ORDER",
      "ruling_page": 1,
      "ruling_quote": "Defendant's motion for summary judgment is granted.",
      "preservation_document_id": "CA9-SUP-000002-OPP",
      "preservation_page": 1,
      "preservation_quote": "The record permits a reasonable inference of work and employer knowledge."
    }
  ],
