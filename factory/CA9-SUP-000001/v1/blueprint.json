  "issues": [
    {
      "id": "I1",
      "question": "Whether the evidence at trial permitted a rational jury to find knowing and willful falsity of the charged answer and its materiality under 18 U.S.C. § 1001(a)(2).",
      "standard_of_review": "De novo review of preserved Rule 29 sufficiency; evidence and reasonable inferences in government favor; not a credibility retrial.",
      "preservation_status": "Preserved at close of government evidence and all evidence, renewed within 14 days after verdict.",
      "appellant_theory": "The answer referred to reconciliation of records, not a representation of personally seeing every item; the wording and contemporaneous records do not exclude a reasonable understanding of a truthful answer. Actual decision process and ability to affect it must be evaluated.",
      "appellee_theory": "Interview context, prior discussion and certification support a rational inference the speaker knowingly represented physical verification; answer could influence monitoring even if follow-up continued.",
      "appellant_relief": "Reverse conviction and direct judgment of acquittal for insufficient evidence.",
      "appellee_relief": "Affirm judgment.",
      "ruling_document_id": "CA9-SUP-000001-ORDER",
      "ruling_page": 1,
      "ruling_quote": "The renewed motion for judgment of acquittal is denied.",
      "preservation_document_id": "CA9-SUP-000001-TRIAL",
      "preservation_page": 64,
      "preservation_quote": "Defense renews the Rule 29 motion on falsity, knowledge and materiality."
    }
  ],
